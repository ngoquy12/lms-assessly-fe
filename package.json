{
    "name": "lms-assessly-fe",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@10.12.1",
    "scripts": {
        "clean": "node -e \"const fs = require('fs'); fs.rmSync('.next', { recursive: true, force: true })\"",
        "dev": "next dev --turbo",
        "dev:clean": "pnpm run clean && pnpm run dev",
        "build": "next build --webpack",
        "start": "next start",
        "format": "prettier --write .",
        "lint": "eslint . --fix",
        "lint:check": "eslint . --max-warnings=0",
        "type-check": "tsc --noEmit",
        "duplication-check": "pnpm dlx jscpd ./src -k 15 -r console --ignore \"**/*.d.ts,**/node_modules/**\"",
        "duplication-report": "pnpm dlx jscpd ./src -k 15 -r html --ignore \"**/*.d.ts,**/node_modules/**\"",
        "prepare": "husky",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.2.2",
        "@monaco-editor/react": "^4.7.0",
        "@next/third-parties": "^16.2.3",
        "@radix-ui/react-avatar": "^1.1.3",
        "@radix-ui/react-checkbox": "^1.1.4",
        "@radix-ui/react-dialog": "^1.1.6",
        "@radix-ui/react-dropdown-menu": "^2.1.6",
        "@radix-ui/react-label": "^2.1.2",
        "@radix-ui/react-popover": "^1.1.6",
        "@radix-ui/react-progress": "^1.1.2",
        "@radix-ui/react-radio-group": "^1.2.3",
        "@radix-ui/react-select": "^2.1.6",
        "@radix-ui/react-separator": "^1.1.2",
        "@radix-ui/react-slot": "^1.1.2",
        "@radix-ui/react-tabs": "^1.1.3",
        "@radix-ui/react-tooltip": "^1.1.8",
        "@tanstack/react-query": "^5.90.10",
        "@tanstack/react-query-devtools": "^5.90.2",
        "@tanstack/react-table": "^8.21.3",
        "@tiptap/extension-code-block": "^3.20.0",
        "@tiptap/extension-image": "^3.11.0",
        "@tiptap/extension-link": "^3.11.0",
        "@tiptap/extension-placeholder": "^3.11.0",
        "@tiptap/extension-table": "^3.11.0",
        "@tiptap/extension-table-cell": "^3.11.0",
        "@tiptap/extension-table-header": "^3.11.0",
        "@tiptap/extension-table-row": "^3.11.0",
        "@tiptap/extension-text-align": "^3.11.0",
        "@tiptap/extension-underline": "^3.11.0",
        "@tiptap/pm": "^3.11.0",
        "@tiptap/react": "^3.20.0",
        "@tiptap/starter-kit": "^3.20.0",
        "chart.js": "^4.5.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "js-cookie": "^3.0.5",
        "lucide-react": "^0.555.0",
        "next": "^16.0.3",
        "next-intl": "^4.13.7",
        "nextjs-toploader": "^3.9.17",
        "react": "^19.2.0",
        "react-chartjs-2": "^5.3.0",
        "react-dom": "^19.2.0",
        "react-hook-form": "^7.53.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.4.0",
        "tailwindcss-animate": "^1.0.7",
        "tailwindcss-react-aria-components": "^2.0.1",
        "tiptap-markdown": "^0.9.0",
        "zod": "^4.1.12",
        "zustand": "^5.0.8"
